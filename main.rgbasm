include "hardware.rgbinc"
include "hardware_compat.rgbinc"
include "utils.rgbinc"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "header", rom0[$0100]
entrypoint:
  di
  jp main
  ds ($0150 - @), 0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

macro DisableLCD
    ; wait for the vblank
    .wait_vblank\@
        ld a, [rLY]
        cp a, SCRN_Y
        jr nz, .wait_vblank\@

    ; turn the LCD off
    xor a
    ld [rLCDC], a
endm

section "main", rom0
main:
  DisableLCD
  call InitSample
  .loop
    call UpdateSample
    jr .loop

section "test", rom0
test:
  ld b, 10
  ld c, 5
  ld d, 2
  call Calculator  

random:
  ld b, 10
  ld hl, $C000
  .loop
    sla b
    ld [hl], b
    ld c, [hl]
    ld_r1_r2 de, bc
    jr nz, .loop
  jp loop

multiply:
  ld a, 1
  ld c, 5
  call Multiply_Function

count_up:
  ld a, 0
  ld b, 10
  .loop
    inc a 
    cp a, b 
    jr nz, .loop

increment_r16:
  ld bc, 0
  .loop
    inc bc
    ld a, b
    or c
    jr nz, .loop

Multiply_Function:
  ld b, a
  ld a, 0
  .loop
    add a, b
    dec c
    jr nz, .loop
  ret

loop:
  jr loop

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;



Calculator:
    ld a, d    
    cp 0          
    jr z, .add
    cp 1        
    jr z, .sub
    cp 2          
    jr z, .double
    ret      

.add:
  ld a, b
  add a, c
  ret ; since you don't call .add, ret turns towards the address provided by call Calculator

.sub:
  ld a, b
  sub c
  ret

.double:
  ld a, b
  sla a
  ret